rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isValidReview(data) {
      return data.keys().hasAll(['name', 'role', 'text', 'rating', 'ownerUid', 'createdAt'])
        && data.keys().hasOnly(['name', 'role', 'text', 'rating', 'ownerUid', 'createdAt'])
        // Data types and lengths
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 60
        && data.role is string
        && data.role.size() <= 80
        && data.text is string
        && data.text.size() >= 10
        && data.text.size() <= 500
        // Rating 1 to 5
        && (data.rating is int || (data.rating is float && int(data.rating) == data.rating))
        && data.rating >= 1
        && data.rating <= 5
        // Valid ownerUid
        && data.ownerUid is string
        && data.ownerUid.size() >= 10
        && data.ownerUid.size() <= 128
        && (request.auth == null || data.ownerUid == request.auth.uid)
        // Must use server timestamp
        && data.createdAt == request.time;
    }

    match /testimonials/{reviewId} {
      // 1. Anyone can read testimonials
      allow read: if true;

      // 2. Allow creating reviews if data passes all strict schema validations
      allow create: if isValidReview(request.resource.data);

      // 3. No modification/edits permitted
      allow update: if false;

      // 4. Owners can delete their own reviews
      allow delete: if (request.auth != null && request.auth.uid == resource.data.ownerUid)
                    || (request.auth == null && resource.data.ownerUid is string);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
